# ==============================================================================
# Smart AirNet / WeatherNet Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual keys
# ==============================================================================

# Supabase Cloud Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_jwt_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key

# Supabase Telemetry Tables & Backend Server
PORT=8000
HOST=0.0.0.0
SOURCE_AQI_TABLE=AQI_NODE1
TABLE_AQI_LIVE=AQI_LIVE_NODE1
TABLE_AQI_HISTORICAL=AQI_NODE1
TABLE_WEATHER_LIVE=WEATHER_LIVE_NODE1
TABLE_WEATHER_HISTORICAL=WEATHER_NODE1
DEST_FORECAST_TABLE=aqi_forecasts_24h
TABLE_AQI_FORECAST=aqi_forecasts_24h
TABLE_WEATHER_FORECAST=weather_forecasts_24h
NODE_ID=node_1
WIND_SPEED_BASELINE=7.86

# Firebase Authentication & Realtime Database
FIREBASE_DATABASE_URL=https://your-firebase-db.firebaseio.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-firebase-app.firebaseapp.com
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_DATABASE_URL=https://your-firebase-db.firebaseio.com

# SMTP Email Delivery (Dataset Requisition Approvals)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_specific_password
ADMIN_EMAIL=your_email@domain.com
ADMIN_PASSWORD=your_secure_admin_password
SENDER_NAME=WeatherNet Data Portal
