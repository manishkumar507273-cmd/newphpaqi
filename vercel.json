{
  "builds": [
    { "src": "php-frontend/assets/**", "use": "@vercel/static" },
    { "src": "php-frontend/css/**", "use": "@vercel/static" },
    { "src": "php-frontend/js/**", "use": "@vercel/static" },
    { "src": "php-frontend/manifest.json", "use": "@vercel/static" },
    { "src": "php-frontend/api/**/*.php", "use": "vercel-php@0.6.2" },
    { "src": "php-frontend/index.php", "use": "vercel-php@0.6.2" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/php-frontend/assets/$1" },
    { "src": "/php-frontend/assets/(.*)", "dest": "/php-frontend/assets/$1" },
    { "src": "/css/(.*)", "dest": "/php-frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "/php-frontend/js/$1" },
    { "src": "/api/(.*)", "dest": "/php-frontend/api/$1" },
    { "src": "/manifest.json", "dest": "/php-frontend/manifest.json" },
    { "src": "/php-frontend/(.*)", "dest": "/php-frontend/index.php" },
    { "src": "/(.*)", "dest": "/php-frontend/index.php" }
  ]
}
