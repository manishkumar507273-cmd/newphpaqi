{
  "builds": [
    { "src": "api/**/*.php", "use": "vercel-php@0.6.2" },
    { "src": "index.php", "use": "vercel-php@0.6.2" }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
